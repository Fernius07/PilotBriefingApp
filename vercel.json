{
  "version": 2,
  "env": {
    "NODE_TLS_REJECT_UNAUTHORIZED": "0"
  },
  "build": {
    "env": {
      "NODE_TLS_REJECT_UNAUTHORIZED": "0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
